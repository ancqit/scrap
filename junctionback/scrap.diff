+def read_object(key: str) -> bytes | None:
+    """Read any bucket key. Missing objects return None. Scrap catalog uses this."""
+    require_r2()
+    try:
+        response = _client().get_object(Bucket=R2_BUCKET, Key=key)
+    except ClientError as exc:
+        code = str(exc.response.get("Error", {}).get("Code", ""))
+        status_code = exc.response.get("ResponseMetadata", {}).get("HTTPStatusCode")
+        if status_code == 404 or code in {"NoSuchKey", "404", "NotFound"}:
+            return None
+        raise
+    return response["Body"].read()
+
+
+def write_object(key: str, body: bytes, *, content_type: str, cache_control: str | None = None) -> None:
+    require_r2()
+    _client().put_object(
+        Bucket=R2_BUCKET,
+        Key=key,
+        Body=body,
+        ContentType=content_type,
+        CacheControl=cache_control or R2_CACHE_CONTROL,
+    )
+
+
+def presign_put_key(key: str, content_type: str) -> str:
+    require_r2()
+    return _client().generate_presigned_url(
+        "put_object",
+        Params={"Bucket": R2_BUCKET, "Key": key, "ContentType": content_type},
+        ExpiresIn=R2_SIGN_EXPIRES_SECONDS,
+    )
+
